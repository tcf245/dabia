# Values live in macOS Keychain; render with keychain-secret (agent-skills/tools).
# Run:  keychain-secret run .env.keychain -- uv run uvicorn dabia.main:app --reload
POSTGRES_USER=dabia
POSTGRES_PASSWORD=keychain:dabia/backend/local/POSTGRES_PASSWORD#eric
POSTGRES_DB=dabia
DATABASE_URL=keychain:dabia/backend/local/DATABASE_URL#eric
GCP_BUCKET_NAME=keychain:dabia/backend/local/GCP_BUCKET_NAME#eric
GCP_MEDIA_PATH=keychain:dabia/backend/local/GCP_MEDIA_PATH#eric
SECRET_KEY=keychain:dabia/backend/local/SECRET_KEY#eric
GRAMMAR_DEBUG_ENABLED=true
GRAMMAR_DEBUG_SOURCE=auto-rule-v1
GOOGLE_CLIENT_ID=keychain:dabia/backend/vercel/preview/GOOGLE_CLIENT_ID#vercel
GOOGLE_CLIENT_SECRET=keychain:dabia/backend/vercel/preview/GOOGLE_CLIENT_SECRET#vercel
